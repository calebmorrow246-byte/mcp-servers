# Your phpIPAM instance URL (no trailing slash).
PHPIPAM_BASE_URL=https://ipam.example.com

# The API application name registered in phpIPAM under Administration > API.
# This is the "App id" (app_id) shown in the phpIPAM API management UI.
PHPIPAM_APP_ID=claude

# Credentials come from Windows Credential Manager by default (no secrets here).
# Target name of the stored generic credential (default "a personal API credential"):
PHPIPAM_CRED_TARGET=a personal API credential

# Optional overrides (CI / quick tests only):
# PHPIPAM_USERNAME=...
# PHPIPAM_PASSWORD=...

# Set to true only if your phpIPAM instance uses a self-signed certificate and
# you have no other option. Not recommended for production.
# PHPIPAM_INSECURE=false
