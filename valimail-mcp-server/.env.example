# Valimail Configuration + Reporting API base URL (same host for both APIs).
VALIMAIL_BASE_URL=https://api.valimail.com

# Your Valimail account slug — the string after /app/ in the URL once logged in.
# Not sure? Contact support@valimail.com and they'll help you find it.
VALIMAIL_ACCOUNT_SLUG=your-account-slug

# Credentials come from Windows Credential Manager by default (no secrets in this file).
# Target name of the stored generic credential (default "Valimail API"):
VALIMAIL_CRED_TARGET=Valimail API

# Optional overrides:
# VALIMAIL_INSECURE=false     # true only to skip TLS verification (not recommended)
# VALIMAIL_CLIENT_ID=...      # bypass Credential Manager (test/CI only)
# VALIMAIL_APP_ID=...         # bypass Credential Manager (test/CI only)
