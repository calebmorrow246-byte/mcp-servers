# Your Qualys platform (POD) API gateway URL — find it in the Qualys UI under
# Help > About, or the "Which Platform / API URL" table. Examples:
#   https://qualysapi.qualys.com            (US Platform 1 / legacy)
#   https://qualysapi.qg2.apps.qualys.com   (US Platform 2)
#   https://qualysapi.qg3.apps.qualys.com   (US Platform 3)
QUALYS_BASE_URL=https://qualysapi.qg3.apps.qualys.com

# Credentials come from Windows Credential Manager by default (no secrets in this file).
# Target name of the stored generic credential (default "Qualys RO"):
QUALYS_CRED_TARGET=Qualys RO

# Optional overrides:
# QUALYS_KB_VERSION=2.0        # set to 3.0 if the KnowledgeBase tool returns a deprecation error
# QUALYS_INSECURE=false        # true only to skip TLS verification (not recommended)
# QUALYS_USERNAME=...          # bypass Credential Manager (test/CI only)
# QUALYS_PASSWORD=...          # bypass Credential Manager (test/CI only)
